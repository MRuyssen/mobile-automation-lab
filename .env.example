# Copy to .env and fill in. Never commit .env. Claude Code is denied read access to it.
# Scripts load it with process.loadEnvFile() at runtime.

# BrowserStack
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=

# TestMu AI (formerly LambdaTest)
LT_USERNAME=
LT_ACCESS_KEY=

# Local devices
ANDROID_AVD=Pixel_8_API_35
# macOS only — pick a name from: xcrun simctl list devices available
IOS_SIM_DEVICE=
IOS_SIM_VERSION=

# Appium
APPIUM_PORT=4723
APPIUM_HOME=.appium
